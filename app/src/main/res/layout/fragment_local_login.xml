<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cli_auth_local"
            android:textColor="@color/primary_text"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/cli_auth_local_form_desc"
            android:textColor="@color/secondary_text"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <Space android:layout_width="match_parent" android:layout_height="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_online_username_hint"
            android:textColor="@color/tertiary_text"
            android:textSize="10sp"
            android:letterSpacing="0.14" />

        <com.kdt.mcgui.MineEditText
            android:id="@+id/login_edit_email"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/cli_input_field"
            android:imeOptions="flagNoExtractUi"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/tertiary_text"
            android:textSize="14sp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/login_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/cli_play_button"
            android:text="@string/login_online_login_label"
            android:textColor="@color/accent_on_accent"
            android:textSize="13sp"
            android:letterSpacing="0.12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:background="@drawable/cli_notice_card"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cli_auth_local_note_title"
                android:textColor="@color/primary_text"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/cli_auth_local_note_body"
                android:textColor="@color/secondary_text"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

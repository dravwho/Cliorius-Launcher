<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_14sdp"
    android:paddingTop="@dimen/_12sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cli_mods_title"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/mods_refresh"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:background="@drawable/cli_field"
            android:contentDescription="@string/cli_mods_refresh"
            android:padding="@dimen/_9sdp"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="@color/primary_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/mods_version_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/_11ssp" />

    <EditText
        android:id="@+id/mods_search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/cli_input_field"
        android:hint="@string/cli_mods_search_hint"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/_12sdp"
        android:textColor="@color/primary_text"
        android:textColorHint="@color/tertiary_text"
        android:textSize="@dimen/_12ssp" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/mods_browse"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/cli_play_button"
        android:text="@string/cli_mods_browse"
        android:textAllCaps="false"
        android:textColor="@color/accent_on_accent"
        android:textSize="@dimen/_12ssp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/_10sdp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mods_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_8sdp" />

        <ProgressBar
            android:id="@+id/mods_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mods_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/cli_mods_empty"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

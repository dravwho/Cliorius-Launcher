<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cli_auth_title"
            android:textColor="@color/primary_text"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/cli_auth_subtitle"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

        <Space android:layout_width="match_parent" android:layout_height="20dp" />

        <!-- Microsoft -->
        <LinearLayout
            android:id="@+id/button_microsoft_authentication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/cli_auth_card"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:background="@drawable/cli_icon_tile"
                android:src="@drawable/ic_auth_microsoft"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cli_auth_microsoft"
                    android:textColor="@color/primary_text"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/cli_auth_microsoft_desc"
                    android:textColor="@color/secondary_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/cli_chevron"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Ely.by / Yggdrasil -->
        <LinearLayout
            android:id="@+id/button_other_authentication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/cli_auth_card"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:background="@drawable/cli_icon_tile"
                android:src="@drawable/ic_auth_ely"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cli_auth_ely"
                    android:textColor="@color/primary_text"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/cli_auth_ely_desc"
                    android:textColor="@color/secondary_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/cli_chevron"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Local / offline -->
        <LinearLayout
            android:id="@+id/button_local_authentication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/cli_auth_card"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:background="@drawable/cli_icon_tile"
                android:src="@drawable/ic_auth_local"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cli_auth_local"
                    android:textColor="@color/primary_text"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/cli_auth_local_desc"
                    android:textColor="@color/secondary_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/cli_chevron"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="18dp" />

        <!-- Notice keamanan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/cli_notice_card"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cli_auth_security_title"
                android:textColor="@color/primary_text"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/cli_auth_security_body"
                android:textColor="@color/secondary_text"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

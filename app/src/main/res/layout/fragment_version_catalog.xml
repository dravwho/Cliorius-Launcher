<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_14sdp"
    android:paddingTop="@dimen/_12sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/version_manager_select_game"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/version_refresh_button"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:background="@drawable/cli_field"
            android:contentDescription="@string/version_manager_refresh"
            android:padding="@dimen/_9sdp"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="@color/primary_text" />
    </LinearLayout>

    <EditText
        android:id="@+id/version_search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_42sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/cli_search"
        android:hint="@string/version_manager_search"
        android:imeOptions="flagNoExtractUi"
        android:inputType="text"
        android:paddingHorizontal="@dimen/_14sdp"
        android:textColor="@color/primary_text"
        android:textColorHint="@color/tertiary_text"
        android:textSize="@dimen/_12ssp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/version_filter_release"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_32sdp"
                android:background="@drawable/cli_chip"
                android:button="@null"
                android:paddingHorizontal="@dimen/_12sdp"
                android:text="@string/version_manager_filter_release"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_11ssp" />

            <Space android:layout_width="@dimen/_6sdp" android:layout_height="match_parent" />

            <CheckBox
                android:id="@+id/version_filter_snapshot"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_32sdp"
                android:background="@drawable/cli_chip"
                android:button="@null"
                android:paddingHorizontal="@dimen/_12sdp"
                android:text="@string/version_manager_filter_snapshot"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_11ssp" />

            <Space android:layout_width="@dimen/_6sdp" android:layout_height="match_parent" />

            <CheckBox
                android:id="@+id/version_filter_april_fools"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_32sdp"
                android:background="@drawable/cli_chip"
                android:button="@null"
                android:paddingHorizontal="@dimen/_12sdp"
                android:text="@string/version_manager_filter_april_fools"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_11ssp" />

            <Space android:layout_width="@dimen/_6sdp" android:layout_height="match_parent" />

            <CheckBox
                android:id="@+id/version_filter_old"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_32sdp"
                android:background="@drawable/cli_chip"
                android:button="@null"
                android:paddingHorizontal="@dimen/_12sdp"
                android:text="@string/version_manager_filter_old"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/version_online_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_12sdp"
            android:scrollbars="none" />

        <ProgressBar
            android:id="@+id/version_loading"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/version_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/_24sdp"
            android:text="@string/version_manager_empty"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

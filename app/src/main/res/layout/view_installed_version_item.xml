<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_installed_version_card"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/installed_version_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:contentDescription="@null"
        android:scaleType="centerInside" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/installed_version_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/installed_version_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_10ssp" />

        <TextView
            android:id="@+id/installed_version_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/version_manager_current"
            android:textColor="@color/accent"
            android:textSize="@dimen/_9ssp"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/installed_version_pin"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/version_manager_pin"
        android:src="@drawable/ic_version_pin" />

    <ImageButton
        android:id="@+id/installed_version_settings"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/version_manager_settings"
        android:src="@drawable/ic_edit_profile" />

    <ImageButton
        android:id="@+id/installed_version_menu"
        android:layout_width="32dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/version_manager_actions"
        android:src="@android:drawable/ic_menu_more" />
</LinearLayout>

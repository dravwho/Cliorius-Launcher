<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33B3B3B3">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp"/>
                    <solid android:color="@color/surface_card_pressed"/>
                    <stroke android:width="1dp" android:color="@color/accent"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp"/>
                    <solid android:color="@color/surface_card"/>
                    <stroke android:width="1dp" android:color="#3AB3B3B3"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
